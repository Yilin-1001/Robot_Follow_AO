# Copy to /etc/robot-follow/humble.env and edit for the new backpack.
FAST_LIO_WS=/home/fk/g1_mid360_ros2_ws
FAST_LIO_CONFIG=/home/fk/g1_mid360_ros2_ws/src/FAST_LIO/config/mid360.yaml
ROBOT_FOLLOW_CONDA_ENV=robot_followao_radar_humble
ROBOT_FOLLOW_CONFIG=/opt/robot-follow/configs/jetson_g1_lidar_alx_assisted_follow_production.yaml
CUPY_CACHE_DIR=/tmp/robot-follow-cupy-cache

# Keep ROS traffic separate from Unitree SDK DDS domain 0.
ROS_DOMAIN_ID=77
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
