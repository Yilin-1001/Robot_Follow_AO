# Copy to /etc/robot-follow/humble.env and edit for the new backpack.
FAST_LIO_WS=/opt/g1_mid360_ros2_ws
FAST_LIO_CONFIG=/opt/g1_mid360_ros2_ws/src/FAST_LIO_ROS2/config/mid360.yaml
ROBOT_FOLLOW_VENV=/opt/robot-follow/.venv-humble
ROBOT_FOLLOW_CONFIG=/opt/robot-follow/configs/jetson_g1_lidar_alx_assisted_follow.yaml

# Keep ROS traffic separate from Unitree SDK DDS domain 0.
ROS_DOMAIN_ID=20
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
